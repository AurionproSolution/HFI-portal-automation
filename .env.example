# Honda Financial Services Dealer Portal

# ── Single switch: pick any dealer from testData/hfi/dealers.json ──
# applicationCompleted: dealer2, dealer8, dealer10
# applicationIncomplete: dealer4, dealer6, dealer12
# resetPassword: dealer1, dealer3, dealer5, dealer7, dealer9, dealer11
ACTIVE_DEALER=dealer4

# Portal environment: dev | uat | qat | sit | prod
# Dev: http://devdealerportal.centralindia.cloudapp.azure.com/login
# UAT: http://uatdealerportal.centralindia.cloudapp.azure.com/login
TEST_ENV=dev

# Optional: override portal URL (wins over TEST_ENV defaults)
# BASE_URL=http://devdealerportal.centralindia.cloudapp.azure.com/login
# BASE_URL=http://uatdealerportal.centralindia.cloudapp.azure.com/login

# Optional: HFS-T0011 idle timeout (ms)
# SESSION_IDLE_TIMEOUT_MS=900000

# Optional: HFS-T0012 long activity test
# RUN_SESSION_ACTIVITY_TEST=true

# Optional: HFS-T0017–T0019 lockout tests (dedicated user)
# LOCKOUT_TEST_USERNAME=
# LOCKOUT_TEST_PASSWORD=

# Optional: HFS-T0020 suspended account
# SUSPENDED_USERNAME=
# SUSPENDED_PASSWORD=

# Optional: destructive reset-password change (TC-007)
# RESET_TEST_ALLOW_PASSWORD_CHANGE=true
# RESET_TEST_NEW_PASSWORD=

# Optional: audit log NFR tests (HFS-T0030–T0033)
# AUDIT_API_URL=

# Optional: US-DLR-009 Purchase Orders & VINs
# PO_VIN_PATH=/dealer-finance/purchase-orders-vins
# PO_VIN_SOLD_UNPAID=<vin>
# PO_VIN_IN_STOCK=<vin>
# PO_VIN_EMPTY_BRANCH=<branch with no data>
# LMS_API_URL=          # TC-002, TC-010, TC-013
# WORLDLINE_TEST_MODE=  # TC-025–TC-033
# RUN_NFR_TESTS=true    # TC-050

# Optional: US-DLR-010 Transaction History
# TRANSACTION_HISTORY_PATH=/dealer-finance/transaction-history
# TXN_HISTORY_SEARCH_PO=
# TXN_HISTORY_SEARCH_TXN=
# TXN_HISTORY_SEARCH_REF=
# TXN_HISTORY_EMPTY_BRANCH=

# Optional: US-OEM-003 Invoice Financing (OEM Portal — not Dealer Portal login)
# OEM login: http://devdealerportal.centralindia.cloudapp.azure.com/oem/login
# OEM_LOGIN_URL=http://devdealerportal.centralindia.cloudapp.azure.com/oem/login
# TEST_ENV=dev
# OEM_MAKER_USERNAME=
# OEM_MAKER_PASSWORD=
# OEM_CHECKER_USERNAME=
# OEM_CHECKER_PASSWORD=
# Per-user probe passwords (optional): OEM_KIRAN_KUMAR_PASSWORD= / OEM_MANOJ_KUMAR_PASSWORD= / OEM_DEALER15_GMAIL_COM_PASSWORD=
# DEALER_LIMITS_PATH=/oem/dealer-limits
# INVOICE_FINANCING_PATH=/oem/invoice-financing
# DEALER_LIMITS_PATH=/oem/dealer-limits
# OEM_UPLOAD_VALID_SINGLE=testData/oem/files/valid_single.xlsx
# OEM_SEARCH_INVOICE= / OEM_SEARCH_DEALER= / OEM_VIEW_DETAILS_REF=
# LOS_API_URL= / LMS_SYNC_WAIT= / RUN_NFR_TESTS=true

# Optional: UC-ADM-001 Admin Console (DEV)
# ADMIN_BASE_URL=http://devdealerportal.centralindia.cloudapp.azure.com/admin
# ADMIN_LOGIN_URL=http://devdealerportal.centralindia.cloudapp.azure.com/admin/login
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_ALLOW_LOGIN_COMMS_SAVE=true

CI=false
