{
  "name": "hondadealerautomation",
  "version": "1.0.0",
  "description": "Playwright automation framework for Honda Financial Services Dealer Portal",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "npx cross-env HEADLESS=false SLOW_MO=300 playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "npx cross-env HEADLESS=false playwright test --debug",
    "test:login": "playwright test --project=login-chromium --workers=1",
    "test:login:headed": "npx cross-env HEADLESS=false SLOW_MO=300 playwright test tests/hfi-portal/Regression/Sprint1/LoginRegression.test.ts --project=login-chromium --workers=1 --headed",
    "test:login:regression": "playwright test tests/hfi-portal/Regression/Sprint1/LoginRegression.test.ts --project=login-chromium --workers=1",
    "test:reset-password": "playwright test tests/hfi-portal/Regression/Sprint1/ResetPasswordRegression.test.ts --project=reset-password-chromium --workers=1",
    "test:onboarding": "playwright test tests/hfi-portal/Regression/Sprint1/OnboardingRegression.test.ts --project=onboarding-chromium --workers=1",
    "test:onboarding:slot": "playwright test tests/hfi-portal/Regression/Sprint1/OnboardingRegression.test.ts -g \"TC-00[2-9]|TC-01[01]\" --project=onboarding-chromium --workers=1",
    "test:onboarding:probes": "playwright test --project=hfi-probes --workers=1",
    "test:in-principal": "playwright test tests/hfi-portal/Regression/Sprint1/InPrincipalRegression.test.ts --project=onboarding-chromium --workers=1",
    "test:collateral": "playwright test tests/hfi-portal/Regression/Sprint1/CollateralRegression.test.ts --project=collateral-chromium --workers=1",
    "test:dealer-finance-dashboard": "playwright test tests/hfi-portal/Regression/Sprint1/DealerFinanceDashboardRegression.test.ts --project=dealer-finance-dashboard-chromium --workers=1",
    "test:profile": "playwright test tests/hfi-portal/Regression/Sprint1/ProfileRegression.test.ts --project=profile-chromium --workers=1",
    "test:contact-info": "playwright test tests/hfi-portal/Regression/Sprint1/ContactInfoUpdateRegression.test.ts --project=contact-info-chromium --workers=1",
    "test:sprint1": "playwright test --project=sprint1-regression --workers=1",
    "test:transaction-history": "playwright test tests/hfi-portal/Regression/Sprint2/TransactionHistoryRegression.test.ts --project=transaction-history-chromium --workers=1",
    "test:purchase-orders-vins": "playwright test tests/hfi-portal/Regression/Sprint2/PurchaseOrdersVINsRegression.test.ts --project=purchase-orders-vins-chromium --workers=1",
    "test:exposure-settings": "playwright test tests/hfi-portal/Regression/Sprint2/ExposureSettingsRegression.test.ts --project=exposure-settings-chromium --workers=1",
    "test:dealer-login": "playwright test tests/hfi-portal/Regression/Sprint2/DealerLoginRegression.test.ts --project=dealer-login-chromium --workers=1",
    "test:oem-invoice-financing": "playwright test tests/oem-portal/Regression/Sprint2/InvoiceFinancingRegression.test.ts --project=oem-invoice-financing-chromium --workers=1",
    "test:oem-dealer-limits": "playwright test tests/oem-portal/Regression/Sprint2/DealerLimitsRegression.test.ts --project=oem-dealer-limits-chromium --workers=1",
    "test:admin-console": "playwright test tests/admin-console/Regression/Sprint2/AdminConsoleRegression.test.ts --project=admin-console-chromium --workers=1",
    "test:oem-sprint2": "playwright test --project=oem-sprint2-regression --workers=1",
    "test:oem-regression": "playwright test --project=oem-full-regression --workers=1",
    "test:sprint2": "playwright test --project=sprint2-regression --workers=1",
    "test:sprint3": "playwright test --project=sprint3-regression --project=oem-sprint3-regression --project=ops-sprint3-regression --workers=1",
    "test:sprint3:hfi": "playwright test --project=sprint3-regression --workers=1",
    "test:sprint3:oem": "playwright test --project=oem-sprint3-regression --workers=1",
    "test:sprint3:ops": "playwright test --project=ops-sprint3-regression --workers=1",
    "generate:sprint3-tests": "node scripts/generate-sprint3-regression-tests.mjs",
    "test:hfi-regression": "playwright test --project=hfi-full-regression --workers=1",
    "test:smoke": "playwright test --grep @smoke --project=smoke",
    "test:sanity": "playwright test tests/sanity --project=portal-chromium",
    "test:regression": "playwright test --project=hfi-full-regression --workers=1",
    "test:e2e": "playwright test tests/e2e --project=portal-chromium",
    "test:setup": "playwright test --project=auth-setup",
    "report": "playwright show-report my-report",
    "report:ortoni": "ortoni-report show-report --dir ortoni-report --file ortoni-report.html",
    "report:ortoni:merge": "ortoni-report merge-report --dir ortoni-report --file ortoni-report.html",
    "report:sprint2-excel": "python scripts/generate-sprint2-management-excel.py",
    "report:sprint2-pass-manifest": "python scripts/generate-sprint2-management-excel.py --export-pass-manifest",
    "test:sprint2-pass-evidence": "node scripts/run-sprint2-pass-evidence.mjs",
    "test:sprint2-pass-evidence:missing": "node scripts/run-sprint2-pass-evidence.mjs --missing-only",
    "lint": "tsc --noEmit",
    "prepare:onboarding-data": "node scripts/prepare-onboarding-testdata.mjs",
    "verify:dealers": "node scripts/verify-dealers.mjs",
    "verify:oem-users": "node scripts/verify-oem-users.mjs",
    "clean": "rimraf test-results my-report playwright-report ortoni-report dist"
  },
  "keywords": [
    "playwright",
    "honda",
    "dealer",
    "automation"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/mcp": "^0.0.79",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "ortoni-report": "^4.10.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  }
}
